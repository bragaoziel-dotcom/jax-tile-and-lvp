# Jax Tile & LVP — Hostinger (LiteSpeed/Apache) rules.
# HTTP -> HTTPS is already handled by Hostinger; do not add another HTTPS rule here (avoids redirect loops behind the CDN).
<IfModule mod_rewrite.c>
RewriteEngine On

# 1) Canonical host: www -> apex (301)
RewriteCond %{HTTP_HOST} ^www\.jaxtileandlvp\.com$ [NC]
RewriteRule ^(.*)$ https://jaxtileandlvp.com/$1 [R=301,L]

# 2) Canonical path: directory URLs with a trailing slash.
#    Legacy *.html aliases and /index.html duplicates 301 to that form so the sitemap URLs are the only indexable copies.
RewriteRule ^index\.html$ https://jaxtileandlvp.com/ [R=301,L]
RewriteRule ^(vinyl-flooring-jacksonville|tile-installation-jacksonville|floor-removal-preparation|service-areas|projects|contact|privacy)\.html$ https://jaxtileandlvp.com/$1/ [R=301,L]
RewriteRule ^(vinyl-flooring-jacksonville|tile-installation-jacksonville|floor-removal-preparation|service-areas|projects|contact|privacy)/index\.html$ https://jaxtileandlvp.com/$1/ [R=301,L]

# 3) Site is English-only: the old Portuguese page (and language variants) go to the homepage (301)
RewriteRule ^(portugues|portuguese|pt|pt-br|es|espanol)(/.*|\.html)?$ / [R=301,L]

# 4) Repo tooling/docs are deployed by Hostinger Git but must not be public
RewriteRule ^(\.github|\.git|docs|scripts)(/|$) - [F,L]
RewriteRule ^README\.md$ - [F,L]
</IfModule>

ErrorDocument 404 /404.html
